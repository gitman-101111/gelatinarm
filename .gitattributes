# Enforce consistent line endings (CRLF) to match .editorconfig.
# Git stores text normalized; working tree is checked out as CRLF.
* text=auto eol=crlf

# Files consumed by Linux tooling must stay LF. The blanket eol=crlf above
# would otherwise check these out with CRLF, and bash fails on the trailing
# carriage return with "$'\r': command not found".
*.yml       text eol=lf
*.yaml      text eol=lf
*.sh        text eol=lf

# Explicit text types
*.cs        text eol=crlf
*.xaml      text eol=crlf
*.csproj    text eol=crlf
*.sln       text eol=crlf
*.json      text eol=crlf
*.xml       text eol=crlf
*.md        text eol=crlf
*.editorconfig text eol=crlf

# Binary assets — never normalize or diff as text
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.bmp   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.pfx   binary
*.snk   binary
*.appx  binary
*.appxbundle binary
*.pri   binary
