<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:Gelatinarm.Shared.Ui">
    <!--  Data Templates  -->
    <DataTemplate x:Key="StandardPosterTemplate">
        <Grid Width="200">
            <Grid.RowDefinitions>
                <RowDefinition Height="280" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Poster Image  -->
            <Border Background="{StaticResource SystemChromeMediumBrush}">
                <Grid>
                    <Image Source="{Binding Converter={StaticResource ImageConverter}, ConverterParameter=Primary}" Stretch="UniformToFill" />
                    <!--  Unwatched Indicator  -->
                    <ui:UnwatchedIndicator HorizontalAlignment="Right" VerticalAlignment="Top" />
                </Grid>
            </Border>

            <!--  Title  -->
            <TextBlock
                Grid.Row="1"
                Style="{StaticResource PosterTitleTextStyle}"
                Text="{Binding Name}" />

            <!--  Subtitle (Year for movies, Series name for episodes)  -->
            <TextBlock
                Grid.Row="2"
                Style="{StaticResource PosterCaptionTextStyle}"
                Text="{Binding Converter={StaticResource MediaSubtitleConverter}}" />
        </Grid>
    </DataTemplate>

    <!--  Recently Added Template - Shows series poster for episodes  -->
    <DataTemplate x:Key="RecentlyAddedTemplate">
        <Grid Width="200">
            <Grid.RowDefinitions>
                <RowDefinition Height="280" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Poster Image  -->
            <Border Background="{StaticResource SystemChromeMediumBrush}">
                <Grid>
                    <Image Source="{Binding Converter={StaticResource ImageConverter}, ConverterParameter=Primary}" Stretch="UniformToFill" />
                    <!--  Unwatched Indicator  -->
                    <ui:UnwatchedIndicator HorizontalAlignment="Right" VerticalAlignment="Top" />
                </Grid>
            </Border>

            <!--  Title - Shows series name for seasons/episodes, regular name for movies  -->
            <TextBlock
                Grid.Row="1"
                Style="{StaticResource PosterTitleTextStyle}"
                Text="{Binding Converter={StaticResource RecentlyAddedTitleConverter}}" />

            <!--  Subtitle - Season info, episode count, or year  -->
            <TextBlock
                Grid.Row="2"
                Style="{StaticResource PosterCaptionTextStyle}"
                Text="{Binding Converter={StaticResource RecentlyAddedSubtitleConverter}}" />
        </Grid>
    </DataTemplate>

    <!--  Compact Poster Template for Grid Views  -->
    <DataTemplate x:Key="CompactPosterTemplate">
        <Grid Width="130" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Poster Image  -->
            <Grid>
                <Rectangle Fill="{StaticResource SystemChromeMediumBrush}" />
                <Image
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Source="{Binding Converter={StaticResource ImageConverter}, ConverterParameter=Primary}" />
                <ui:UnwatchedIndicator HorizontalAlignment="Right" VerticalAlignment="Top" />
            </Grid>

            <!--  Title  -->
            <TextBlock
                Grid.Row="1"
                Margin="2,2,2,0"
                HorizontalAlignment="Center"
                FontSize="11"
                Style="{StaticResource StandardBodyTextStyle}"
                Text="{Binding Name}"
                TextAlignment="Center"
                TextTrimming="CharacterEllipsis" />

            <!--  Subtitle (Year/Series info)  -->
            <TextBlock
                Grid.Row="2"
                Margin="2,0"
                HorizontalAlignment="Center"
                FontSize="10"
                Style="{StaticResource StandardCaptionTextStyle}"
                Text="{Binding Converter={StaticResource MediaSubtitleConverter}}"
                TextAlignment="Center"
                TextTrimming="CharacterEllipsis" />
        </Grid>
    </DataTemplate>

    <!--  Compact Episode Template for Grid Views  -->
    <DataTemplate x:Key="CompactEpisodeTemplate">
        <Grid Width="240" Height="180">
            <Grid.RowDefinitions>
                <RowDefinition Height="135" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Episode Thumbnail  -->
            <Border Background="{StaticResource SystemChromeMediumBrush}">
                <Grid>
                    <Image Source="{Binding Converter={StaticResource ImageConverter}, ConverterParameter=Backdrop}" Stretch="UniformToFill" />
                    <!--  Progress Bar (if watching)  -->
                    <Rectangle
                        Height="{StaticResource ProgressBarHeight}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Fill="{StaticResource SystemControlHighlightAccentBrush}"
                        Visibility="{Binding UserData.PlayedPercentage, Converter={StaticResource ProgressBarVisibilityConverter}, FallbackValue=Collapsed}">
                        <Rectangle.Width>
                            <Binding
                                Converter="{StaticResource PercentageToWidthConverter}"
                                ConverterParameter="240"
                                FallbackValue="0"
                                Path="UserData.PlayedPercentage" />
                        </Rectangle.Width>
                    </Rectangle>
                </Grid>
            </Border>

            <!--  Episode Info  -->
            <StackPanel Grid.Row="1" Margin="4,4,4,0">
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Text="{Binding Name}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Style="{StaticResource SmallCaptionTextStyle}"
                    Text="{Binding SeriesName}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!--  Compact Album Template for Grid Views  -->
    <DataTemplate x:Key="CompactAlbumTemplate">
        <Grid Width="150">
            <Grid.RowDefinitions>
                <RowDefinition Height="130" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Square Album Art  -->
            <Border
                Width="130"
                Height="130"
                HorizontalAlignment="Center"
                Background="{StaticResource SystemChromeMediumBrush}">
                <Image Source="{Binding Converter={StaticResource ImageConverter}, ConverterParameter=Primary}" Stretch="UniformToFill" />
            </Border>

            <!--  Album Name  -->
            <TextBlock
                Grid.Row="1"
                Margin="0,2,0,0"
                FontSize="12"
                FontWeight="SemiBold"
                Text="{Binding Name}"
                TextAlignment="Center"
                TextTrimming="CharacterEllipsis" />

            <!--  Artist Name  -->
            <TextBlock
                Grid.Row="2"
                Margin="0,0,0,2"
                Style="{StaticResource SmallCaptionTextStyle}"
                Text="{Binding AlbumArtist}"
                TextAlignment="Center"
                TextTrimming="CharacterEllipsis" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ContinueWatchingItemTemplate">
        <Grid Width="400" Height="225">
            <!--  Background Image  -->
            <Border Background="{StaticResource SystemChromeMediumBrush}">
                <Image
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Source="{Binding Converter={StaticResource ImageConverter}, ConverterParameter=Backdrop}" />
            </Border>

            <!--  Subtle Dark Overlay at Bottom  -->
            <Border Height="100" VerticalAlignment="Bottom">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="{StaticResource ScrimEndColor}" />
                        <GradientStop Offset="1" Color="{StaticResource ScrimColor}" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!--  Text Content  -->
            <Border
                MinHeight="60"
                Padding="12,8,12,12"
                VerticalAlignment="Bottom">
                <StackPanel>
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Style="{StaticResource SecondaryTextStyle}"
                        Text="{Binding Converter={StaticResource ContinueWatchingSubtitleConverter}}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <!--  Progress Bar  -->
            <Rectangle
                Height="{StaticResource ProgressBarHeight}"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Fill="{StaticResource SystemControlHighlightAccentBrush}"
                Visibility="{Binding UserData.PlayedPercentage, Converter={StaticResource ProgressBarVisibilityConverter}, FallbackValue=Collapsed}">
                <Rectangle.Width>
                    <Binding
                        Converter="{StaticResource PercentageToWidthConverter}"
                        ConverterParameter="400"
                        FallbackValue="0"
                        Path="UserData.PlayedPercentage" />
                </Rectangle.Width>
            </Rectangle>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
