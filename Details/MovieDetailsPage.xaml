<?xml version="1.0" encoding="utf-8" ?>

<local:DetailsPage
    x:Class="Gelatinarm.Details.MovieDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Gelatinarm.Details"
    xmlns:ui="using:Gelatinarm.Shared.Ui"
    Background="{StaticResource ApplicationPageBackgroundThemeBrush}">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Details/DetailsResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style
                x:Key="MetaLabelTextStyle"
                BasedOn="{StaticResource StandardCaptionTextStyle}"
                TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <!--  Backdrop Image - Full Screen Background  -->
        <Image Source="{x:Bind ViewModel.BackdropImage, Mode=OneWay}" Stretch="UniformToFill" />

        <!--  Dark overlay for better text readability  -->
        <Grid Background="{StaticResource OverlayScrimBrush}" />

        <!--  Scrollable Content  -->
        <ListView
            ScrollViewer.BringIntoViewOnFocusChange="False"
            ScrollViewer.VerticalScrollMode="Auto"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="IsTabStop" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Top" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>

            <!--  Hero Section  -->
            <Grid Padding="{StaticResource SafeAreaPadding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  Poster  -->
                    <Border
                        Width="200"
                        Height="300"
                        Margin="{StaticResource SafeAreaPadding}"
                        CornerRadius="2">
                        <Grid>
                            <Image Source="{x:Bind ViewModel.PrimaryImage, Mode=OneWay}" Stretch="UniformToFill" />

                            <!--  Progress Bar Overlay  -->
                            <Grid VerticalAlignment="Bottom" Visibility="{x:Bind ViewModel.CanResume, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <!--  Progress bar background  -->
                                <Rectangle
                                    Height="{StaticResource ProgressBarHeight}"
                                    VerticalAlignment="Bottom"
                                    Fill="{StaticResource SystemControlBackgroundBaseMediumLowBrush}" />
                                <!--  Progress bar  -->
                                <Rectangle
                                    Width="{x:Bind ViewModel.PlayedPercentage, Mode=OneWay, Converter={StaticResource PercentageToWidthConverter}, ConverterParameter=200}"
                                    Height="{StaticResource ProgressBarHeight}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    Fill="{StaticResource SystemControlHighlightAccentBrush}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!--  Info  -->
                    <StackPanel
                        Grid.Column="1"
                        Margin="{StaticResource HeaderMargin}"
                        VerticalAlignment="Top">
                        <TextBlock
                            Margin="0,0,0,8"
                            Style="{StaticResource PageTitleTextStyle}"
                            Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                            TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.Year, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource SeparatorTextStyle}" Visibility="{x:Bind ViewModel.Year, Mode=OneWay, Converter={StaticResource NullableToVisibilityConverter}}" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.Runtime, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource SeparatorTextStyle}" Visibility="{x:Bind ViewModel.Runtime, Mode=OneWay, Converter={StaticResource NullableToVisibilityConverter}}" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.Rating, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource SeparatorTextStyle}" Visibility="{x:Bind ViewModel.Rating, Mode=OneWay, Converter={StaticResource NullableToVisibilityConverter}}" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.GenresText, Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel
                            Margin="0,8,0,0"
                            Orientation="Horizontal"
                            Spacing="16">
                            <StackPanel Orientation="Horizontal" Visibility="{x:Bind ViewModel.CommunityRating, Mode=OneWay, Converter={StaticResource NullableToVisibilityConverter}}">
                                <SymbolIcon Foreground="{StaticResource RatingStarBrush}" Symbol="SolidStar" />
                                <TextBlock
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource StandardBodyTextStyle}"
                                    Text="{x:Bind ViewModel.CommunityRating, Mode=OneWay, Converter={StaticResource MediaTextConverter}, ConverterParameter=Rating}" />
                                <TextBlock
                                    Margin="2,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="/10" />
                            </StackPanel>
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="4"
                                Visibility="{x:Bind ViewModel.CriticRating, Mode=OneWay, Converter={StaticResource NullableToVisibilityConverter}}">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="Critics" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource StandardBodyTextStyle}"
                                    Text="{x:Bind ViewModel.CriticRating, Mode=OneWay, Converter={StaticResource MediaTextConverter}, ConverterParameter=CriticRating}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel MaxWidth="700" Margin="{StaticResource HeaderMargin}">
                            <TextBlock
                                MaxHeight="{x:Bind ViewModel.OverviewMaxHeight, Mode=OneWay}"
                                LineHeight="20"
                                Style="{StaticResource StandardBodyTextStyle}"
                                Text="{x:Bind ViewModel.Overview, Mode=OneWay}"
                                TextTrimming="WordEllipsis"
                                TextWrapping="Wrap" />
                            <Button
                                Margin="0,8,0,0"
                                Command="{x:Bind ViewModel.ToggleBioExpansionCommand}"
                                Content="{x:Bind ViewModel.ExpandBioButtonText, Mode=OneWay}"
                                Style="{StaticResource TextBlockButtonStyle}"
                                Visibility="{x:Bind ViewModel.IsExpandBioButtonVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>

                        <!--  Director and Writers  -->
                        <Grid MaxWidth="700" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  Director  -->
                            <TextBlock
                                Style="{StaticResource SubsectionHeaderTextStyle}"
                                Text="Director:"
                                Visibility="{x:Bind ViewModel.Director, Mode=OneWay, Converter={StaticResource NullableToVisibilityConverter}}" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource StandardBodyTextStyle}"
                                Text="{x:Bind ViewModel.Director, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.Director, Mode=OneWay, Converter={StaticResource NullableToVisibilityConverter}}" />

                            <!--  Writers  -->
                            <TextBlock
                                Grid.Row="1"
                                Margin="0,8,0,0"
                                Style="{StaticResource SubsectionHeaderTextStyle}"
                                Text="Writers:"
                                Visibility="{x:Bind ViewModel.Writers, Mode=OneWay, Converter={StaticResource NullableToVisibilityConverter}}" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,8,0,0"
                                Style="{StaticResource StandardBodyTextStyle}"
                                Text="{x:Bind ViewModel.Writers, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.Writers, Mode=OneWay, Converter={StaticResource NullableToVisibilityConverter}}" />
                        </Grid>

                        <!--  Playback Options  -->
                        <StackPanel Margin="0,32,0,0">
                            <Grid
                                MaxWidth="900"
                                ColumnSpacing="12"
                                RowSpacing="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <!--  Labels Row  -->
                                <TextBlock Style="{StaticResource MetaLabelTextStyle}" Text="Version" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource MetaLabelTextStyle}"
                                    Text="Audio" />
                                <TextBlock
                                    Grid.Column="2"
                                    Style="{StaticResource MetaLabelTextStyle}"
                                    Text="Subtitles" />

                                <!--  Dropdowns Row  -->
                                <ComboBox
                                    x:Name="VersionComboBox"
                                    Grid.Row="1"
                                    HorizontalAlignment="Stretch"
                                    DisplayMemberPath="Name"
                                    ItemsSource="{x:Bind ViewModel.AvailableVersions, Mode=OneWay}"
                                    SelectedItem="{x:Bind ViewModel.SelectedVersion, Mode=TwoWay}"
                                    XYFocusDown="{x:Bind PlayButton}" />
                                <ComboBox
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    DisplayMemberPath="DisplayName"
                                    ItemsSource="{x:Bind ViewModel.AvailableAudioTracks, Mode=OneWay}"
                                    SelectedItem="{x:Bind ViewModel.SelectedAudioTrack, Mode=TwoWay}"
                                    XYFocusDown="{x:Bind PlayButton}" />
                                <ComboBox
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    HorizontalAlignment="Stretch"
                                    DisplayMemberPath="DisplayTitle"
                                    ItemsSource="{x:Bind ViewModel.AvailableSubtitleTracks, Mode=OneWay}"
                                    SelectedItem="{x:Bind ViewModel.SelectedSubtitleTrack, Mode=TwoWay}"
                                    XYFocusDown="{x:Bind PlayButton}" />
                            </Grid>
                        </StackPanel>

                        <!--  Action Buttons  -->
                        <StackPanel
                            Margin="0,24,0,0"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                x:Name="PlayButton"
                                MinWidth="100"
                                MinHeight="36"
                                Command="{x:Bind ViewModel.PlayCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                XYFocusDown="{x:Bind CastListView}"
                                XYFocusUp="{x:Bind VersionComboBox}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Play" />
                                    <TextBlock Text="{x:Bind ViewModel.PlayButtonText, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                            <Button
                                MinWidth="100"
                                MinHeight="36"
                                Command="{x:Bind ViewModel.RestartCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Visibility="{x:Bind ViewModel.CanResume, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Refresh" />
                                    <TextBlock Text="Restart" />
                                </StackPanel>
                            </Button>
                            <Button
                                MinWidth="100"
                                MinHeight="36"
                                Command="{x:Bind ViewModel.ToggleFavoriteCommand}"
                                Style="{StaticResource SecondaryButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="{x:Bind ViewModel.IsFavorite, Mode=OneWay, Converter={StaticResource FavoriteIconConverter}}" />
                                    <TextBlock Text="Favorite" />
                                </StackPanel>
                            </Button>
                            <Button
                                MinWidth="130"
                                MinHeight="36"
                                Command="{x:Bind ViewModel.ToggleWatchedCommand}"
                                Style="{StaticResource SecondaryButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Accept" />
                                    <TextBlock Text="{x:Bind ViewModel.WatchedButtonText, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>

            <!--  Cast Section  -->
            <Grid Padding="{StaticResource SafeAreaPadding}" Visibility="{x:Bind ViewModel.HasCast, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Margin="{StaticResource StandardControlMargin}"
                    Style="{StaticResource SectionHeaderTextStyle}"
                    Text="Cast" />

                <ListView
                    x:Name="CastListView"
                    Grid.Row="1"
                    Padding="0,0,14,0"
                    IsItemClickEnabled="True"
                    ItemClick="OnCastItemClick"
                    ItemTemplate="{StaticResource CastMemberTemplate}"
                    ItemsSource="{x:Bind ViewModel.Cast, Mode=OneWay}"
                    ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                    ScrollViewer.HorizontalScrollMode="Enabled"
                    ScrollViewer.VerticalScrollMode="Disabled"
                    SelectionMode="None"
                    TabNavigation="Local"
                    XYFocusUp="{x:Bind PlayButton}">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="10" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </Grid>

            <!--  Similar Movies  -->
            <Grid Padding="{StaticResource SafeAreaPadding}" Visibility="{x:Bind ViewModel.HasSimilarItems, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Margin="{StaticResource StandardControlMargin}"
                    Style="{StaticResource SectionHeaderTextStyle}"
                    Text="Similar Movies" />

                <ScrollViewer
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Hidden"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollMode="Disabled">
                    <GridView
                        ItemClick="OnMovieItemClick"
                        ItemTemplate="{StaticResource StandardPosterTemplate}"
                        ItemsSource="{x:Bind ViewModel.SimilarItems, Mode=OneWay}"
                        Style="{StaticResource MediaRowGridViewStyle}" />
                </ScrollViewer>
            </Grid>
            <!--  Collection Siblings  -->
            <Grid Padding="{StaticResource SafeAreaPadding}" Visibility="{x:Bind ViewModel.HasCollectionSiblings, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Margin="{StaticResource StandardControlMargin}"
                    Style="{StaticResource SectionHeaderTextStyle}"
                    Text="{x:Bind ViewModel.CollectionSectionTitle, Mode=OneWay}" />

                <ScrollViewer
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Hidden"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollMode="Disabled">
                    <GridView
                        ItemClick="OnMovieItemClick"
                        ItemTemplate="{StaticResource StandardPosterTemplate}"
                        ItemsSource="{x:Bind ViewModel.CollectionSiblings, Mode=OneWay}"
                        Style="{StaticResource MediaRowGridViewStyle}" />
                </ScrollViewer>
            </Grid>
        </ListView>

        <!--  Loading State  -->
        <ui:LoadingOverlay IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}" LoadingText="Loading movie details..." />
    </Grid>
</local:DetailsPage>
