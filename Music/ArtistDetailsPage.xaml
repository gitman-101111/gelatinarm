<?xml version="1.0" encoding="utf-8" ?>

<local:MusicDetailsPage
    x:Class="Gelatinarm.Music.ArtistDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Gelatinarm.Music"
    xmlns:ui="using:Gelatinarm.Shared.Ui"
    Background="{StaticResource ApplicationPageBackgroundThemeBrush}"
    NavigationCacheMode="Enabled">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Details/DetailsResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style
                x:Key="ArtistActionButtonStyle"
                BasedOn="{StaticResource SecondaryButtonStyle}"
                TargetType="Button">
                <Setter Property="Padding" Value="12,0" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <ScrollViewer
            Padding="48,24,48,48"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!--  Artist Header Section  -->
                <Grid
                    Height="300"
                    Margin="0,0,0,24"
                    Background="{StaticResource SystemChromeLowBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  Artist Image  -->
                    <Border Margin="24" Background="{StaticResource SystemControlBackgroundChromeMediumBrush}">
                        <Image Source="{x:Bind ViewModel.PrimaryImage, Mode=OneWay}" Stretch="UniformToFill" />
                    </Border>

                    <!--  Artist Info  -->
                    <StackPanel
                        Grid.Column="1"
                        Margin="0,24,24,24"
                        VerticalAlignment="Center">
                        <TextBlock
                            Style="{StaticResource PageTitleTextStyle}"
                            Text="{x:Bind ViewModel.ArtistName, Mode=OneWay}"
                            TextWrapping="Wrap" />

                        <TextBlock
                            MaxLines="4"
                            Style="{StaticResource SecondaryTextStyle}"
                            Text="{x:Bind ViewModel.Overview, Mode=OneWay}"
                            TextTrimming="WordEllipsis"
                            TextWrapping="Wrap" />

                        <!--  Action Buttons  -->
                        <StackPanel
                            Margin="0,12,0,0"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                x:Name="PlayAllButton"
                                Command="{x:Bind ViewModel.PlayCommand, Mode=OneWay}"
                                Style="{StaticResource ArtistActionButtonStyle}"
                                XYFocusDown="{x:Bind AlbumsItemsControl}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xE768;" />
                                    <TextBlock Text="Play All" />
                                </StackPanel>
                            </Button>

                            <Button Command="{x:Bind ViewModel.ShuffleCommand, Mode=OneWay}" Style="{StaticResource ArtistActionButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xE8B1;" />
                                    <TextBlock Text="Shuffle" />
                                </StackPanel>
                            </Button>

                            <Button Command="{x:Bind ViewModel.InstantMixCommand, Mode=OneWay}" Style="{StaticResource ArtistActionButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xE8E5;" />
                                    <TextBlock Text="Instant Mix" />
                                </StackPanel>
                            </Button>

                            <Button Command="{x:Bind ViewModel.ToggleFavoriteCommand, Mode=OneWay}" Style="{StaticResource ArtistActionButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="{x:Bind ViewModel.IsFavorite, Converter={StaticResource FavoriteIconConverter}, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind ViewModel.FavoriteButtonText, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!--  Albums Section  -->
                <StackPanel Margin="24,0,24,24">
                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Albums" />

                    <!--  Albums List  -->
                    <ItemsControl
                        x:Name="AlbumsItemsControl"
                        IsTabStop="False"
                        ItemsSource="{x:Bind ViewModel.Albums, Mode=OneWay}"
                        XYFocusUp="{x:Bind PlayAllButton}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,0,16"
                                    Padding="16"
                                    Background="{StaticResource SystemChromeMediumLowBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!--  Album Art  -->
                                        <Image
                                            Width="150"
                                            Height="150"
                                            IsHitTestVisible="False"
                                            Source="{Binding Album, Converter={StaticResource ImageConverter}, ConverterParameter=Primary}"
                                            Stretch="UniformToFill" />

                                        <!--  Track List  -->
                                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                            <TextBlock
                                                Margin="0,0,0,8"
                                                Style="{StaticResource SubheaderTextStyle}"
                                                Text="{Binding Album.Name}" />

                                            <TextBlock
                                                Margin="0,0,0,12"
                                                Style="{StaticResource StandardCaptionTextStyle}"
                                                Text="{Binding Album.ProductionYear}" />

                                            <!--  Album Tracks  -->
                                            <ListView
                                                IsItemClickEnabled="True"
                                                IsTabStop="True"
                                                ItemTemplate="{StaticResource TrackRowTemplate}"
                                                ItemsSource="{Binding Tracks}"
                                                PreviewKeyDown="OnPreviewKeyDown"
                                                ScrollViewer.VerticalScrollMode="Auto"
                                                SelectionMode="None">
                                                <ListView.ItemContainerStyle>
                                                    <Style TargetType="ListViewItem">
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                        <Setter Property="Padding" Value="0" />
                                                        <Setter Property="Margin" Value="0,2" />
                                                        <Setter Property="MinHeight" Value="0" />
                                                    </Style>
                                                </ListView.ItemContainerStyle>
                                            </ListView>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!--  Loading State  -->
        <ui:LoadingOverlay IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}" LoadingText="Loading artist details..." />
    </Grid>
</local:MusicDetailsPage>
