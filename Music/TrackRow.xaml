<?xml version="1.0" encoding="utf-8" ?>

<UserControl
    x:Class="Gelatinarm.Music.TrackRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Button Click="OnClick" Style="{StaticResource TrackButtonStyle}">
        <Button.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem Click="OnPlay" Text="Play">
                    <MenuFlyoutItem.Icon>
                        <SymbolIcon Symbol="Play" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Click="OnPlayNext" Text="Play Next">
                    <MenuFlyoutItem.Icon>
                        <SymbolIcon Symbol="Next" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Click="OnAddToQueue" Text="Add to Queue">
                    <MenuFlyoutItem.Icon>
                        <SymbolIcon Symbol="Add" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Click="OnStartInstantMix" Text="Start Instant Mix">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8E5;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </Button.ContextFlyout>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="80" />
            </Grid.ColumnDefinitions>

            <!--  Track number: disc-track on a multi-disc album  -->
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource SecondaryTextStyle}"
                Text="{Binding Overview}" />
            <TextBlock
                Grid.Column="1"
                Margin="16,0"
                VerticalAlignment="Center"
                Style="{StaticResource StandardBodyTextStyle}"
                Text="{Binding Name}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                Grid.Column="2"
                Margin="0,0,16,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Style="{StaticResource SecondaryTextStyle}"
                Text="{Binding RunTimeTicks, Converter={StaticResource RuntimeConverter}}" />
        </Grid>
    </Button>
</UserControl>
