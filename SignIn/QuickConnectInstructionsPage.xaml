<?xml version="1.0" encoding="utf-8" ?>

<base:BasePage
    x:Class="Gelatinarm.SignIn.QuickConnectInstructionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:Gelatinarm.Shared.Base"
    Background="{StaticResource ApplicationPageBackgroundThemeBrush}"
    IsTabStop="False">
    <base:BasePage.Resources>
        <Style
            x:Key="InstructionTextStyle"
            BasedOn="{StaticResource StandardBodyTextStyle}"
            TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </base:BasePage.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <TextBlock
            Margin="48,24,48,8"
            HorizontalAlignment="Center"
            Style="{StaticResource PageTitleTextStyle}"
            Text="Quick Connect Instructions" />

        <!--  Instructions Content  -->
        <ScrollViewer
            Grid.Row="1"
            Padding="48,12,48,80"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!--  Quick Connect Code Display  -->
                <Border Style="{StaticResource InstructionHighlightBoxStyle}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock
                            Margin="4"
                            HorizontalAlignment="Center"
                            Style="{StaticResource StandardBodyTextStyle}"
                            Text="Your Quick Connect Code:" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="22"
                            FontWeight="Bold"
                            Text="{x:Bind ViewModel.QuickConnectCode, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <!--  Step-by-step Instructions  -->
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        FontWeight="SemiBold"
                        Style="{StaticResource StandardBodyTextStyle}"
                        Text="Follow these steps to connect:" />

                    <!--  Step 1  -->
                    <StackPanel Style="{StaticResource InstructionStepContainerStyle}">
                        <Border Style="{StaticResource InstructionStepNumberStyle}">
                            <TextBlock Style="{StaticResource InstructionStepNumberTextStyle}" Text="1" />
                        </Border>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource InstructionTextStyle}"
                            Text="Open your Jellyfin web interface in a browser on any device" />
                    </StackPanel>

                    <!--  Step 2  -->
                    <StackPanel Style="{StaticResource InstructionStepContainerStyle}">
                        <Border Style="{StaticResource InstructionStepNumberStyle}">
                            <TextBlock Style="{StaticResource InstructionStepNumberTextStyle}" Text="2" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource InstructionTextStyle}" Text="Navigate to the Quick Connect page:" />
                            <TextBlock
                                Margin="{StaticResource CompactControlMargin}"
                                FontFamily="Consolas"
                                Foreground="{StaticResource SystemControlHighlightAccentBrush}"
                                Style="{StaticResource StandardCaptionTextStyle}"
                                Text="{x:Bind ViewModel.QuickConnectUrl, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <!--  Step 3  -->
                    <StackPanel Style="{StaticResource InstructionStepContainerStyle}">
                        <Border Style="{StaticResource InstructionStepNumberStyle}">
                            <TextBlock Style="{StaticResource InstructionStepNumberTextStyle}" Text="3" />
                        </Border>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource InstructionTextStyle}"
                            Text="Enter the code shown above" />
                    </StackPanel>

                    <!--  Step 4  -->
                    <StackPanel Style="{StaticResource InstructionStepContainerStyle}">
                        <Border Style="{StaticResource InstructionStepNumberStyle}">
                            <TextBlock Style="{StaticResource InstructionStepNumberTextStyle}" Text="4" />
                        </Border>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource InstructionTextStyle}"
                            Text="Click 'Submit' and this app will automatically sign in" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!--  Connection Status  -->
        <StackPanel
            Grid.Row="1"
            Margin="{StaticResource StandardControlMargin}"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom">
            <ProgressRing
                Width="40"
                Height="40"
                Foreground="{StaticResource SystemControlHighlightAccentBrush}"
                IsActive="{x:Bind ViewModel.IsConnectionProgressActive, Mode=OneWay}" />

            <TextBlock
                Margin="0,8"
                HorizontalAlignment="Center"
                Style="{StaticResource StandardBodyTextStyle}"
                Text="{x:Bind ViewModel.ConnectionStatus, Mode=OneWay}" />
        </StackPanel>

        <!--  Bottom Actions  -->
        <StackPanel
            Grid.Row="2"
            Margin="48,12,48,24"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <Button
                x:Name="CancelButton"
                Width="120"
                Command="{x:Bind ViewModel.CancelCommand}"
                Content="Cancel"
                Style="{StaticResource SecondaryButtonStyle}" />
        </StackPanel>
    </Grid>
</base:BasePage>
