# Gelatinarm.Analyzers options. GEL035 (same-named mutable state in several classes): names read by
# hand and found not to be copies of one owner's state. GEL036 (repeated blocks): declarative
# tables, parallel by nature.
[*.cs]
gelatinarm_shadow_state_known = disposed, playbackParams, serverUrl, currentFilter, emptyStateMessage, emptyStateTitle, servicesInitialized, musicPlayerService, isInitialized, localSettings, currentMediaSource, autoPlayNextEpisode
gelatinarm_clone_skip_files = Playback/DeviceProfileService.cs

# The analyzer project: its classes are instantiated by the compiler, and the analyzer-authoring
# release-tracking files (RS2008) add nothing for rules that live with the one project they check
[Gelatinarm.Analyzers/**.cs]
dotnet_diagnostic.RS2008.severity = none
dotnet_diagnostic.CA1812.severity = none

# AppPreferences spells its defaults out on purpose: they are the settings' documented values
[Shared/Preferences/AppPreferences.cs]
dotnet_diagnostic.CA1805.severity = none
