<?xml version="1.0" encoding="utf-8" ?>

<base:BasePage
    x:Class="Gelatinarm.Search.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:Gelatinarm.Shared.Base"
    xmlns:ui="using:Gelatinarm.Shared.Ui"
    Background="{StaticResource ApplicationPageBackgroundThemeBrush}"
    NavigationCacheMode="Required">
    <base:BasePage.Resources>
        <StaticResource x:Key="SearchItemTemplate" ResourceKey="CompactPosterTemplate" />
        <StaticResource x:Key="EpisodeItemTemplate" ResourceKey="CompactEpisodeTemplate" />
        <StaticResource x:Key="MusicItemTemplate" ResourceKey="CompactAlbumTemplate" />
    </base:BasePage.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Fixed Header with Search and Filters  -->
        <Border Style="{StaticResource PageHeaderBarStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="350" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Search Label  -->
                <TextBlock
                    Margin="0,0,24,0"
                    Style="{StaticResource PageHeaderTextStyle}"
                    Text="Search" />

                <!--  Search Box  -->
                <TextBox
                    x:Name="SearchBox"
                    Grid.Column="1"
                    Height="44"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    KeyDown="SearchBox_KeyDown"
                    PlaceholderText="Search for movies, TV shows, music..."
                    Style="{StaticResource StandardTextBoxStyle}" />

                <!--  Filter Buttons  -->
                <StackPanel
                    Grid.Column="2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        x:Name="AllButton"
                        Click="FilterButton_Click"
                        Content="All"
                        Style="{StaticResource FilterButtonStyle}" />
                    <Button
                        x:Name="MoviesButton"
                        Click="FilterButton_Click"
                        Content="Movies"
                        Style="{StaticResource FilterButtonStyle}" />
                    <Button
                        x:Name="ShowsButton"
                        Click="FilterButton_Click"
                        Content="TV Shows"
                        Style="{StaticResource FilterButtonStyle}" />
                    <Button
                        x:Name="EpisodesButton"
                        Click="FilterButton_Click"
                        Content="Episodes"
                        Style="{StaticResource FilterButtonStyle}" />
                    <Button
                        x:Name="MusicButton"
                        Click="FilterButton_Click"
                        Content="Music"
                        Style="{StaticResource FilterButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  Search Results  -->
        <Grid Grid.Row="1">
            <ScrollViewer TabNavigation="Once" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="{StaticResource SafeAreaPadding}">
                    <!--  Results Count  -->
                    <TextBlock
                        x:Name="ResultsCountText"
                        Margin="{StaticResource HeaderMargin}"
                        Style="{StaticResource SecondaryTextStyle}"
                        Visibility="Collapsed" />

                    <!--  Grouped Results  -->
                    <StackPanel x:Name="GroupedResultsPanel">
                        <!--  Groups will be added dynamically in code-behind  -->
                    </StackPanel>

                    <!--  No Results Panel  -->
                    <StackPanel
                        x:Name="NoResultsPanel"
                        Margin="{StaticResource SectionMargin}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                        <TextBlock
                            Foreground="{StaticResource SystemControlForegroundBaseMediumBrush}"
                            Style="{StaticResource SectionHeaderTextStyle}"
                            Text="{x:Bind EmptyStateTitle, Mode=OneWay}"
                            TextAlignment="Center" />
                        <TextBlock
                            Margin="{StaticResource StandardControlMargin}"
                            Style="{StaticResource SecondaryTextStyle}"
                            Text="{x:Bind EmptyStateMessage, Mode=OneWay}"
                            TextAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!--  Loading Indicator - Last so it appears on top  -->
            <ui:LoadingOverlay x:Name="LoadingOverlay" LoadingText="Searching..." />
        </Grid>
    </Grid>
</base:BasePage>
