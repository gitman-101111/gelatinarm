<?xml version="1.0" encoding="utf-8" ?>

<UserControl
    x:Class="Gelatinarm.Shared.Ui.UnwatchedIndicator"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <!--  Triangle indicator for movies  -->
        <Polygon
            x:Name="TriangleIndicator"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Fill="{StaticResource UnwatchedIndicatorBrush}"
            Points="0,0 30,0 30,30"
            Visibility="Collapsed" />

        <!--  Square indicator with count for TV shows  -->
        <Border
            x:Name="SquareIndicator"
            Height="24"
            MinWidth="24"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Background="{StaticResource UnwatchedIndicatorBrush}"
            Visibility="Collapsed">
            <TextBlock
                x:Name="CountText"
                Padding="6,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="12"
                FontWeight="Bold" />
        </Border>
    </Grid>
</UserControl>
