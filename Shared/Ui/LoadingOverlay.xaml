<?xml version="1.0" encoding="utf-8" ?>

<UserControl
    x:Class="Gelatinarm.Shared.Ui.LoadingOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource OverlayScrimBrush}" Visibility="{x:Bind IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Invisible button to capture focus and block navigation  -->
        <Button
            x:Name="FocusCapture"
            Grid.RowSpan="4"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            KeyDown="FocusCapture_KeyDown"
            Opacity="0"
            UseSystemFocusVisuals="False" />

        <ProgressRing
            Grid.Row="1"
            Width="60"
            Height="60"
            Foreground="{StaticResource SystemControlHighlightAccentBrush}"
            IsActive="{x:Bind IsLoading, Mode=OneWay}" />

        <TextBlock
            Grid.Row="2"
            Margin="0,16,0,0"
            HorizontalAlignment="Center"
            FontSize="16"
            Text="{x:Bind LoadingText, Mode=OneWay}"
            Visibility="{x:Bind LoadingText, Mode=OneWay, Converter={StaticResource NullableToVisibilityConverter}}" />
    </Grid>
</UserControl>
