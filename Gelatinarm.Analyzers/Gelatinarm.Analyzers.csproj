<Project Sdk="Microsoft.NET.Sdk">

  <!-- The audit's rules, as Roslyn analyzers: dead and misplaced members counted by symbol (with
       XAML references), the XAML checks (resource keys, names, defaults, wrappers), and the
       shapes the stock analyzers do not see. Gelatinarm.csproj references this project as an
       analyzer, so every build of the app runs them; Docs/DEV_SETUP.md lists the rules. -->

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <Nullable>disable</Nullable>
    <RootNamespace>Gelatinarm.Analyzers</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 4.14: the API the app's CodeStyle package is built for, and older than the compiler
         in Visual Studio 18 (5.x), which is what loads these analyzers -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
