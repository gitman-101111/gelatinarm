    <AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
    <LangVersion>9.0</LangVersion>
    <GenerateTemporaryStoreCertificate>True</GenerateTemporaryStoreCertificate>
    <AppxBundlePlatforms>x64</AppxBundlePlatforms>
    <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
    <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
    <AppxAutoIncrementPackageRevision>False</AppxAutoIncrementPackageRevision>
    <GenerateTestArtifacts>True</GenerateTestArtifacts>
    <AppxBundle>Always</AppxBundle>
    <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
    <!-- IDE0005 (unnecessary using) reports only when the compiler writes documentation; CS1591
         (missing XML comment) is then turned off, since summaries here say why, not what -->
    <DocumentationFile>obj\$(Platform)\$(Configuration)\Gelatinarm.xml</DocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
  <!-- Two editions from one source (see Docs/DEV_SETUP.md). Standard keeps background music
       and caps video at 1080p; 4K takes the restricted hevcPlayback capability, which lifts
       the cap but closes the app when a game starts. Debug4K/Release4K select the 4K
       edition; /p:Edition=4K works with any configuration. -->
  <PropertyGroup>
    <Edition Condition="'$(Edition)' == '' and ('$(Configuration)' == 'Debug4K' or '$(Configuration)' == 'Release4K')">4K</Edition>
    <Edition Condition="'$(Edition)' == ''">Standard</Edition>
    <BaseConfiguration Condition="'$(Configuration)' == 'Debug' or '$(Configuration)' == 'Debug4K'">Debug</BaseConfiguration>
    <BaseConfiguration Condition="'$(Configuration)' == 'Release' or '$(Configuration)' == 'Release4K'">Release</BaseConfiguration>
  </PropertyGroup>
  <PropertyGroup Condition="'$(BaseConfiguration)|$(Platform)' == 'Debug|x64'">
    <DebugSymbols>true</DebugSymbols>
    <OutputPath>bin\x64\$(Configuration)\</OutputPath>
    <DefineConstants>DEBUG;TRACE;NETFX_CORE;WINDOWS_UWP</DefineConstants>
    <NoWarn>;2008;1591</NoWarn>
    <DebugType>full</DebugType>
    <PlatformTarget>x64</PlatformTarget>
    <UseVSHostingProcess>false</UseVSHostingProcess>
    <ErrorReport>prompt</ErrorReport>
    <Prefer32Bit>true</Prefer32Bit>
    <UseDotNetNativeToolchain>true</UseDotNetNativeToolchain>
    <EnableGatekeeperAnalysis>false</EnableGatekeeperAnalysis>
  </PropertyGroup>
  <PropertyGroup Condition="'$(BaseConfiguration)|$(Platform)' == 'Release|x64'">
    <OutputPath>bin\x64\$(Configuration)\</OutputPath>
    <DefineConstants>TRACE;NETFX_CORE;WINDOWS_UWP</DefineConstants>
    <Optimize>true</Optimize>
    <NoWarn>;2008;1591</NoWarn>
    <DebugType>pdbonly</DebugType>
    <PlatformTarget>x64</PlatformTarget>
    <UseVSHostingProcess>false</UseVSHostingProcess>
    <ErrorReport>prompt</ErrorReport>
    <Prefer32Bit>false</Prefer32Bit>
    <UseDotNetNativeToolchain>true</UseDotNetNativeToolchain>
    <EnableGatekeeperAnalysis>false</EnableGatekeeperAnalysis>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Edition)' == '4K'">
    <DefineConstants>$(DefineConstants);EDITION_4K</DefineConstants>
  </PropertyGroup>
  <!-- The packaging targets treat any configuration not named exactly "Debug" as a Store
       build and add an upload package, whose signing clean-up then fails
       (RemoveDisposableSigningCertificate: no CertificateThumbprint). Debug4K is a debug
       build: sideload package only, as Debug gets. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug4K'">
    <UapAppxPackageBuildMode Condition="'$(UapAppxPackageBuildMode)' == ''">SideloadOnly</UapAppxPackageBuildMode>
  </PropertyGroup>
