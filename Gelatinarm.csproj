  <PropertyGroup Condition=" '$(VisualStudioVersion)' == '' or '$(VisualStudioVersion)' &lt; '14.0' ">
    <VisualStudioVersion>14.0</VisualStudioVersion>
  </PropertyGroup>
  <Import Project="$(MSBuildExtensionsPath)\Microsoft\WindowsXaml\v$(VisualStudioVersion)\Microsoft.Windows.UI.Xaml.CSharp.targets" />
  <!-- The 4K edition's manifest is written from Package.appxmanifest at build time, so the
       two never drift (one version number, one set of assets). Every substitution must
       match exactly once, or the build fails rather than packaging a half-converted
       manifest. -->
  <UsingTask TaskName="WriteEditionManifest" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <Destination ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var text = File.ReadAllText(Source);
        var failed = false;
        Func<string, string, string, string> swap = (input, pattern, replacement) =>
        {
            var count = Regex.Matches(input, pattern).Count;
            if (count != 1)
            {
                Log.LogError("4K manifest: expected one match for {0} in {1}, found {2}", pattern, Source, count);
                failed = true;
                return input;
            }
            return Regex.Replace(input, pattern, replacement);
        };

        // Own identity, so both editions can be installed side by side
        text = swap(text, "(<Identity\\s+Name=\")([^\"]+)(\")", "$1${2}4K$3");
        text = swap(text, "PhoneProductId=\"[^\"]+\"", "PhoneProductId=\"a73cbff0-25c2-4f62-9bfe-fc4d6dc2dd50\"");
        text = swap(text, "<DisplayName>Gelatinarm</DisplayName>", "<DisplayName>Gelatinarm 4K</DisplayName>");
        text = swap(text, "(<uap:VisualElements\\s+)DisplayName=\"Gelatinarm\"", "$1DisplayName=\"Gelatinarm 4K\"");
        text = swap(text, "ShortName=\"Gelatinarm\"", "ShortName=\"Gelatinarm 4K\"");

        // 4K instead of background music
        text = swap(text, "IgnorableNamespaces=\"([^\"]*)\"",
            "xmlns:rescap=\"http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities\"\r\n  IgnorableNamespaces=\"$1 rescap\"");
        text = swap(text, "<uap3:Capability Name=\"backgroundMediaPlayback\" />", "<rescap:Capability Name=\"hevcPlayback\" />");

        if (failed)
        {
            return false;
        }

        Directory.CreateDirectory(Path.GetDirectoryName(Destination));
        if (!File.Exists(Destination) || File.ReadAllText(Destination) != text)
        {
            File.WriteAllText(Destination, text, new UTF8Encoding(true));
        }
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="WriteEditionManifest" BeforeTargets="PrepareForBuild" Condition="'$(Edition)' == '4K'">
    <WriteEditionManifest Source="$(MSBuildProjectDirectory)\Package.appxmanifest" Destination="$(MSBuildProjectDirectory)\$(IntermediateOutputPath)Package.4K.appxmanifest" />
  </Target>
  <!-- XAML Styler is the one form the XAML is written in. The build checks every page against it
       (xstyler, the local dotnet tool in .config/dotnet-tools.json, in passive mode) and fails when
       one strays; FormatXaml rewrites them into form. One xstyler run over all files costs what one
       file does, so the check is a single pass, skipped while no XAML has changed. -->
  <ItemGroup>
    <XamlToStyle Include="@(ApplicationDefinition);@(Page)" />
  </ItemGroup>
  <!-- xstyler names a failing file on the line before its FAIL; pairing them gives one error per file -->
  <UsingTask TaskName="XamlStylerFailures" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Lines ParameterType="System.String[]" Required="true" />
      <Files ParameterType="System.String[]" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.Collections.Generic" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var files = new List<string>();
        for (var i = 1; i < Lines.Length; i++)
        {
            if (Lines[i].Trim() == "FAIL" && Lines[i - 1].StartsWith("Checking: "))
            {
                files.Add(Lines[i - 1].Substring("Checking: ".Length).Trim());
            }
        }

        Files = files.ToArray();
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="RestoreXamlStyler" Inputs="$(MSBuildProjectDirectory)\.config\dotnet-tools.json" Outputs="$(IntermediateOutputPath)xamlstyler.restored" Condition="'$(CheckXamlStyle)' != 'false'">
    <Exec Command="dotnet tool restore" WorkingDirectory="$(MSBuildProjectDirectory)" StandardOutputImportance="low" />
    <Touch Files="$(IntermediateOutputPath)xamlstyler.restored" AlwaysCreate="true" />
    <ItemGroup>
      <FileWrites Include="$(IntermediateOutputPath)xamlstyler.restored" />
    </ItemGroup>
  </Target>
  <Target Name="CheckXamlStyle" DependsOnTargets="RestoreXamlStyler" BeforeTargets="MarkupCompilePass1" Inputs="@(XamlToStyle);$(MSBuildProjectDirectory)\.config\dotnet-tools.json" Outputs="$(IntermediateOutputPath)xamlstyle.checked" Condition="'$(CheckXamlStyle)' != 'false'">
    <Exec Command="dotnet tool run xstyler -- -p -l Default -f &quot;@(XamlToStyle->'%(FullPath)', ',')&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" IgnoreExitCode="true" ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="XamlStyleExitCode" />
      <Output TaskParameter="ConsoleOutput" ItemName="XamlStyleOutput" />
    </Exec>
    <XamlStylerFailures Condition="'$(XamlStyleExitCode)' != '0'" Lines="@(XamlStyleOutput)">
      <Output TaskParameter="Files" ItemName="XamlNotStyled" />
    </XamlStylerFailures>
    <Error Condition="'$(XamlStyleExitCode)' != '0' and '@(XamlNotStyled)' == ''" Text="XAML Styler: @(XamlStyleOutput, ' ')" />
    <Error Condition="'@(XamlNotStyled)' != ''" ContinueOnError="ErrorAndContinue" File="%(XamlNotStyled.Identity)" Text="Not in XAML Styler form. Run msbuild Gelatinarm.csproj /t:FormatXaml (or dotnet xstyler -f &quot;%(XamlNotStyled.Identity)&quot;) and rebuild." />
    <Touch Files="$(IntermediateOutputPath)xamlstyle.checked" AlwaysCreate="true" />
    <ItemGroup>
      <FileWrites Include="$(IntermediateOutputPath)xamlstyle.checked" />
    </ItemGroup>
  </Target>
  <Target Name="FormatXaml" DependsOnTargets="RestoreXamlStyler">
    <Exec Command="dotnet tool run xstyler -- -l Minimal -f &quot;@(XamlToStyle->'%(FullPath)', ',')&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
</Project>