    <!-- Build-time analyzers only (not shipped). The rules .editorconfig raises to warnings fail the
         audit's build gate (baseline: no warnings but ILT0005): constant log templates, unused
         usings, members, parameters and values, and the perf rules that matter on an Xbox One. -->
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers">
      <Version>10.0.401</Version>
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.CodeStyle">
      <Version>4.14.0</Version>
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Semantic redundancy rules the regex scans cannot see: conditions always true or false,
         dead stores, redundant casts and jumps, one-use wrappers. Severities in .editorconfig. -->
    <PackageReference Include="SonarAnalyzer.CSharp">
      <Version>10.34.0.3385</Version>
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.Analyzers">
      <Version>5.0.0</Version>
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- The audit's own rules (Docs/DEV_SETUP.md lists them), built with the app and run by the
         compiler on every build. The XAML and rd.xml go in as AdditionalFiles so the rules can read them. -->
    <ProjectReference Include="Gelatinarm.Analyzers\Gelatinarm.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SetConfiguration="Configuration=Release" SetPlatform="Platform=AnyCPU" />
