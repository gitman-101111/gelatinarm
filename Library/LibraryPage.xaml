<?xml version="1.0" encoding="utf-8" ?>

<base:BasePage
    x:Class="Gelatinarm.Library.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:Gelatinarm.Shared.Base"
    xmlns:local="using:Gelatinarm.Library"
    xmlns:ui="using:Gelatinarm.Shared.Ui"
    Background="{StaticResource ApplicationPageBackgroundThemeBrush}">
    <base:BasePage.Resources>
        <!--  Alphabet Button Style  -->
        <Style x:Key="AlphabetButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="MinWidth" Value="24" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!--  One checkbox per option, in every list of the filter flyout  -->
        <DataTemplate x:Key="FilterOptionTemplate" x:DataType="local:FilterItem">
            <CheckBox
                Margin="{StaticResource CompactControlMargin}"
                Content="{x:Bind Name}"
                IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
        </DataTemplate>

        <Style x:Key="FilterOptionListStyle" TargetType="ListView">
            <Setter Property="SelectionMode" Value="None" />
            <Setter Property="ItemTemplate" Value="{StaticResource FilterOptionTemplate}" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid
                            ItemWidth="240"
                            MaximumRowsOrColumns="3"
                            Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="32" />
                        <Setter Property="IsTabStop" Value="False" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FilterSectionStyle" TargetType="Border">
            <Setter Property="Padding" Value="{StaticResource StandardControlMargin}" />
            <Setter Property="BorderBrush" Value="{StaticResource SystemControlForegroundBaseLowBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style
            x:Key="FilterHeadingTextStyle"
            BasedOn="{StaticResource StandardBodyTextStyle}"
            TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="{StaticResource StandardControlMargin}" />
        </Style>
    </base:BasePage.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  Fixed Header with Filters  -->
        <Border Grid.ColumnSpan="2" Style="{StaticResource PageHeaderBarStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Library Name with Count as subtitle  -->
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageHeaderTextStyle}" Text="{x:Bind ViewModel.LibraryName, Mode=OneWay}" />
                    <TextBlock
                        Style="{StaticResource StandardCaptionTextStyle}"
                        Text="{x:Bind ViewModel.ItemCountSubtitle, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ItemCountSubtitle, Mode=OneWay, Converter={StaticResource NullableToVisibilityConverter}}" />
                </StackPanel>

                <!--  Centered Controls  -->
                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <!--  Music View Type Dropdown - Only visible for music libraries  -->
                    <ComboBox
                        x:Name="MusicViewComboBox"
                        MinWidth="100"
                        PlaceholderText="View"
                        SelectedIndex="0"
                        SelectionChanged="MusicViewComboBox_SelectionChanged"
                        Style="{StaticResource LibraryHeaderComboBoxStyle}"
                        Visibility="{x:Bind ViewModel.IsMusicLibrary, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ComboBoxItem Content="Artists" Tag="Artists" />
                        <ComboBoxItem Content="Albums" Tag="Albums" />
                    </ComboBox>
                    <!--  Sort By  -->
                    <ComboBox
                        PlaceholderText="Sort By"
                        SelectedIndex="{x:Bind ViewModel.SelectedSortIndex, Mode=TwoWay}"
                        Style="{StaticResource LibraryHeaderComboBoxStyle}">
                        <ComboBoxItem Content="Name" />
                        <ComboBoxItem Content="Date Added" />
                        <ComboBoxItem Content="Release Date" />
                        <ComboBoxItem Content="Community Rating" />
                        <ComboBoxItem Content="Critic Rating" />
                        <ComboBoxItem Content="Random" />
                    </ComboBox>

                    <!--  Sort Order  -->
                    <Button
                        Width="120"
                        Margin="{StaticResource CompactControlMargin}"
                        Click="SortOrderButton_Click"
                        Style="{StaticResource SecondaryButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="{x:Bind ViewModel.IsAscending, Mode=OneWay, Converter={StaticResource SortFilterConverter}, ConverterParameter=Icon}" />
                            <TextBlock Text="{x:Bind ViewModel.IsAscending, Mode=OneWay, Converter={StaticResource SortFilterConverter}, ConverterParameter=Text}" />
                        </StackPanel>
                    </Button>

                    <!--  Search Button  -->
                    <Button
                        Width="40"
                        Margin="{StaticResource CompactControlMargin}"
                        Click="SearchButton_Click"
                        Style="{StaticResource SecondaryButtonStyle}"
                        ToolTipService.ToolTip="Search">
                        <FontIcon FontSize="16" Glyph="&#xE094;" />
                    </Button>

                    <!--  Filter Button that opens multi-select flyout  -->
                    <Button
                        x:Name="FilterButton"
                        Width="40"
                        Margin="{StaticResource CompactControlMargin}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        ToolTipService.ToolTip="Filters">
                        <Grid>
                            <FontIcon FontSize="16" Glyph="&#xE71C;" />
                            <!--  Filter count badge  -->
                            <Border
                                Height="12"
                                MinWidth="12"
                                Margin="0,-4,-4,0"
                                Padding="2,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="{StaticResource SystemControlHighlightAccentBrush}"
                                CornerRadius="6"
                                Visibility="{x:Bind ViewModel.HasActiveFilters, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="9"
                                    FontWeight="Bold"
                                    Text="{x:Bind ViewModel.ActiveFilterCount, Mode=OneWay}" />
                            </Border>
                        </Grid>
                        <Button.Flyout>
                            <Flyout
                                Opened="FilterFlyout_Opened"
                                Opening="FilterFlyout_Opening"
                                Placement="Full">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <Setter Property="Width" Value="800" />
                                        <Setter Property="MaxHeight" Value="800" />
                                        <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
                                        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                                        <Setter Property="IsTabStop" Value="False" />
                                        <Setter Property="TabNavigation" Value="Once" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <Grid
                                    x:Name="FilterFlyoutRoot"
                                    MinHeight="600"
                                    MaxHeight="800">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!--  Header  -->
                                    <TextBlock
                                        Margin="{StaticResource HeaderMargin}"
                                        Style="{StaticResource SubheaderTextStyle}"
                                        Text="Filter Options" />

                                    <!--  Filter Lists  -->
                                    <ScrollViewer
                                        Grid.Row="1"
                                        Padding="{StaticResource HeaderMargin}"
                                        HorizontalScrollMode="Disabled"
                                        TabNavigation="Once"
                                        VerticalScrollBarVisibility="Hidden"
                                        VerticalScrollMode="Enabled">
                                        <StackPanel>
                                            <!--  Watched/Unwatched Filter  -->
                                            <Border Style="{StaticResource FilterSectionStyle}" Visibility="{x:Bind ViewModel.ShowPlayedStatusFilter, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource FilterHeadingTextStyle}" Text="Status" />
                                                    <ItemsControl ItemTemplate="{StaticResource FilterOptionTemplate}" ItemsSource="{x:Bind ViewModel.PlayedStatuses, Mode=OneWay}" />
                                                </StackPanel>
                                            </Border>

                                            <!--  Genre Filter  -->
                                            <Border Style="{StaticResource FilterSectionStyle}" Visibility="{x:Bind ViewModel.ShowGenreFilter, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource FilterHeadingTextStyle}" Text="Genres" />
                                                    <ListView ItemsSource="{x:Bind ViewModel.Genres, Mode=OneWay}" Style="{StaticResource FilterOptionListStyle}" />
                                                </StackPanel>
                                            </Border>

                                            <!--  Year Filter  -->
                                            <Border Style="{StaticResource FilterSectionStyle}" Visibility="{x:Bind ViewModel.ShowYearFilter, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource FilterHeadingTextStyle}" Text="Years" />

                                                    <!--  Decade Checkboxes  -->
                                                    <Grid x:Name="DecadesGrid" Margin="0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <!--  Decades will be populated in code-behind  -->
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <!--  Rating Filter  -->
                                            <Border Style="{StaticResource FilterSectionStyle}" Visibility="{x:Bind ViewModel.ShowRatingFilter, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource FilterHeadingTextStyle}" Text="Ratings" />
                                                    <ListView ItemsSource="{x:Bind ViewModel.Ratings, Mode=OneWay}" Style="{StaticResource FilterOptionListStyle}" />
                                                </StackPanel>
                                            </Border>

                                            <!--  Resolution Filter  -->
                                            <!--  The last section has no line under it  -->
                                            <Border
                                                BorderThickness="0"
                                                Style="{StaticResource FilterSectionStyle}"
                                                Visibility="{x:Bind ViewModel.ShowResolutionFilter, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource FilterHeadingTextStyle}" Text="Quality" />
                                                    <ListView ItemsSource="{x:Bind ViewModel.Resolutions, Mode=OneWay}" Style="{StaticResource FilterOptionListStyle}">
                                                        <ListView.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <ItemsWrapGrid
                                                                    ItemWidth="180"
                                                                    MaximumRowsOrColumns="4"
                                                                    Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ListView.ItemsPanel>
                                                    </ListView>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <!--  Action Buttons  -->
                                    <Grid Grid.Row="2" Margin="{StaticResource HeaderMargin}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Button
                                            x:Name="ClearFiltersButton"
                                            Click="ClearFiltersButton_Click"
                                            Content="Clear All"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            XYFocusRight="{x:Bind CancelFilterButton}" />

                                        <StackPanel
                                            Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            Orientation="Horizontal">
                                            <Button
                                                x:Name="CancelFilterButton"
                                                Margin="0,0,4,0"
                                                Click="CancelFilterButton_Click"
                                                Content="Cancel"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                XYFocusLeft="{x:Bind ClearFiltersButton}" />
                                            <Button
                                                Click="ApplyFilterButton_Click"
                                                Content="Apply"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                XYFocusLeft="{x:Bind CancelFilterButton}" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <!--  Right-side buttons  -->
                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <!--  Shuffle Button - Only visible for music libraries  -->
                    <Button
                        Width="110"
                        Click="ShuffleButton_Click"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Visibility="{x:Bind ViewModel.IsMusicLibrary, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE8B1;" />
                            <TextBlock Text="Shuffle All" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  Alphabet Selector  -->
        <ScrollViewer
            Grid.Row="1"
            Grid.Column="1"
            Width="40"
            HorizontalScrollBarVisibility="Hidden"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Enabled"
            Visibility="{x:Bind ViewModel.ShowJumpLetters, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ItemsControl
                Margin="{StaticResource StandardControlMargin}"
                IsTabStop="False"
                ItemsSource="{x:Bind ViewModel.JumpLetters, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Button
                            Click="OnJumpLetterClick"
                            Content="{x:Bind}"
                            Loaded="OnJumpLetterLoaded"
                            Style="{StaticResource AlphabetButtonStyle}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!--  Media List  -->
        <ListView
            x:Name="MediaGrid"
            Grid.Row="1"
            Margin="{StaticResource StandardControlMargin}"
            DataContext="{x:Bind ViewModel}"
            IsItemClickEnabled="True"
            ItemClick="MediaGrid_ItemClick"
            ItemsSource="{x:Bind ViewModel.MediaItems, Mode=OneWay}"
            ScrollViewer.HorizontalScrollBarVisibility="Hidden"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplateSelector>
                <local:LibraryItemTemplateSelector
                    AlbumTemplate="{StaticResource CompactAlbumTemplate}"
                    ArtistTemplate="{StaticResource CompactAlbumTemplate}"
                    DefaultTemplate="{StaticResource CompactPosterTemplate}" />
            </ListView.ItemTemplateSelector>
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid
                        HorizontalAlignment="Left"
                        ItemHeight="{Binding ItemHeight}"
                        ItemWidth="{Binding ItemWidth}"
                        Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
        </ListView>

        <!--  Loading Indicator  -->
        <ui:LoadingOverlay
            Grid.RowSpan="2"
            Grid.ColumnSpan="2"
            IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            LoadingText="Loading library..." />

        <!--  Empty State  -->
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock
                Margin="0,0,0,16"
                HorizontalAlignment="Center"
                Foreground="{StaticResource SystemControlForegroundBaseMediumBrush}"
                Style="{StaticResource SectionHeaderTextStyle}"
                Text="{x:Bind ViewModel.EmptyStateTitle, Mode=OneWay}"
                TextAlignment="Center" />
            <TextBlock
                MaxWidth="400"
                HorizontalAlignment="Center"
                Style="{StaticResource SecondaryTextStyle}"
                Text="{x:Bind ViewModel.EmptyStateMessage, Mode=OneWay}"
                TextAlignment="Center" />
        </StackPanel>
    </Grid>
</base:BasePage>
